{
  "schema": "NSD_DORTMUND_HEALTHY_NATIVE_MOTION_V0_1",
  "dataset": {
    "id": "ds005385",
    "version": "1.0.3",
    "doi": "10.18112/openneuro.ds005385.v1.0.3"
  },
  "independence_rule": "No NSD-derived variable, threshold, or historical control result enters baseline construction.",
  "preprocessing": {
    "bandpass_hz": [
      1,
      40
    ],
    "reference": "average",
    "psd": "welch",
    "sampling_hz": 1000,
    "welch_n_fft": 4096,
    "welch_n_per_seg": 4096,
    "welch_n_overlap": 2048,
    "frequency_resolution_hz": 0.244140625
  },
  "features": {
    "posterior_alpha_relative_power": {
      "band_hz": [
        8,
        13
      ],
      "denominator_hz": [
        1,
        40
      ],
      "roi": "parietal_parieto-occipital_occipital",
      "integration": "trapezoidal_psd_integral"
    },
    "alpha_peak_frequency": {
      "search_hz": [
        8,
        13
      ],
      "roi": "posterior",
      "definition": "maximum posterior_mean_psd within 8-13 Hz"
    },
    "theta_beta_ratio": {
      "theta_hz": [
        4,
        8
      ],
      "beta_hz": [
        13,
        30
      ],
      "aggregation": "whole_scalp_mean_psd_then_band_ratio"
    },
    "aperiodic_exponent": {
      "fit_hz": [
        2,
        40
      ],
      "peak_width_hz": [
        1,
        8
      ],
      "max_peaks": 6,
      "min_peak_height": 0.1,
      "aperiodic_mode": "fixed",
      "aggregation": "whole_scalp_mean_psd_primary"
    }
  },
  "pilot": {
    "target_subjects": 40,
    "selection": "deterministic_age_sex_stratified_metadata_only",
    "conditions": [
      "EC_pre",
      "EC_post",
      "EO_pre",
      "EO_post"
    ],
    "eligibility": "session1=yes; pilot selection prefers late_ses1=0; full cohort will not inherit this pilot-only convenience filter",
    "selection_order": "age_bin_then_sex_then participant_id lexicographic; 4 per sex in each age bin 20-29,30-39,40-49,50-59,60-70 where available"
  },
  "prohibited": [
    "NSD chi",
    "NSD modal/vector Chi",
    "Chi_arc",
    "diagnostic thresholds",
    "outcome-driven tuning"
  ],
  "method_discrepancy_rule": "No post-outcome parameter changes. Any discrepancy from Park et al. 2026 triggers a new prospective version after root-cause analysis."
}
